# Usage (example):
#   docker build -t magma-cross/aflplusplus/libpng \
#       --build-arg fuzzer=aflplusplus \
#       --build-arg target=libpng \
#       --build-arg target_arch=arm-linux-gnueabihf \
#       --build-arg user_id="$(id -u)" \
#       --build-arg group_id="$(id -g)" \
#       --build-arg canaries=1 \
#       -f DOCKERFILE_PIRATE .

FROM ubuntu:18.04

################################################################################
# Environment Setup
################################################################################
## Magma directory hierarchy
# magma_root is relative to the docker-build's working directory
# The Docker image must be built in the root of the magma directory
# So we must provide the context usen $MAGMA_R
ENV HOST_CONTEXT_ROOT=./

ENV MAGMA_R=/magma

ARG fuzzer=aflplusplus
ARG target=libpng
ARG target_arch=arm-linux-gnueabihf
ARG user_id=1000
ARG group_id=1000
ARG isan
ARG harden
ARG canaries
ARG fixes

ENV FUZZER_NAME=${fuzzer}
ENV FUZZER=${MAGMA_R}/fuzzers/${FUZZER_NAME}
ENV TARGET_NAME=${target}
ENV TARGET=${MAGMA_R}/targets/${TARGET_NAME}
ENV TARGET_ARCH=${target_arch}
ENV USERID=${user_id}
ENV GROUPID=${group_id}

ENV MAGMA=${MAGMA_R}/magma
ENV OUT=/magma_out
ENV SHARED=/magma_shared
ENV DEPS_PATH=/magma_deps
ENV QEMU_SYSROOT=/magma_sysroot

# Compiler Variables x86
ENV CC=/usr/bin/gcc
ENV CXX=/usr/bin/g++
ENV LD=/usr/bin/ld
ENV AR=/usr/bin/ar
ENV AS=/usr/bin/as
ENV NM=/usr/bin/nm
ENV RANLIB=/usr/bin/ranlib

# Compiler variables cross
ENV TARGET_CC=/usr/bin/${target_arch}-gcc
ENV TARGET_CXX=/usr/bin/${target_arch}-g++
ENV TARGET_AR=/usr/bin/${target_arch}-ar
ENV TARGET_LD=/usr/bin/${target_arch}-ld
ENV TARGET_NM=/usr/bin/${target_arch}-nm
ENV TARGET_RANLIB=/usr/bin/${target_arch}-ranlib




##
# IMPORTANT:
# AFL++ Settings
#########################################################
# Needs to be set for shared libs (see doc)
ENV AFL_INST_LIBS=1

# Don't hook main(), This is done by libAFLQemuDriver.a
ENV AFL_QEMU_DRIVER_NO_HOOK=1
#########################################################


################################################################################
# Initial OS and environment setup
################################################################################
# Use bash. Ubuntu defaults to dash!
SHELL ["/bin/bash", "-c"]

USER root:root

RUN apt-get update && apt-get install -y sudo

# Install cross-compilation toolchain and QEMU
# Note: Using DEBIAN_FRONTEND only for this RUN to avoid tzdata prompts
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y \
    gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf \
    gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
    qemu-user qemu-user-static



# Add ARM32 repositories
RUN dpkg --add-architecture armhf

RUN echo "deb [arch=amd64] http://archive.ubuntu.com/ubuntu/ bionic main restricted universe multiverse" > /etc/apt/sources.list && \
    echo "deb [arch=amd64] http://archive.ubuntu.com/ubuntu/ bionic-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=amd64] http://security.ubuntu.com/ubuntu/ bionic-security main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports/ bionic main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports/ bionic-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports/ bionic-security main restricted universe multiverse" >> /etc/apt/sources.list

RUN apt-get update



# Debug dependencies
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y \
    file vim

RUN mkdir -p /home && \
	groupadd -g ${GROUPID} magma && \
	useradd -l -u ${USERID} -K UMASK=0000 -d /home -g magma magma && \
	chown magma:magma /home
RUN	echo "magma:magma" | chpasswd && \
    usermod -a -G sudo magma && \
    echo "magma ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/magma && \
    chmod 0440 /etc/sudoers.d/magma

RUN mkdir -p ${SHARED} ${OUT} ${SHARED} ${DEPS_PATH} ${QEMU_SYSROOT} && \
    chown magma:magma ${SHARED} ${OUT} ${SHARED} ${DEPS_PATH} ${QEMU_SYSROOT} && \
    chmod 755 ${SHARED} ${OUT} ${SHARED} ${DEPS_PATH} ${QEMU_SYSROOT}

RUN mkdir -p ${DEPS_PATH}/{lib,include} ${QEMU_SYSROOT}/{lib,usr/lib}


################################################################################
# Magma Instrumentation
################################################################################
USER root:root
RUN mkdir -p ${MAGMA} && chown magma:magma ${MAGMA}
COPY --chown=magma:magma ${HOST_CONTEXT_ROOT}/magma ${MAGMA}
RUN ${MAGMA}/preinstall.sh
USER magma:magma
RUN ${MAGMA}/prebuild.sh

################################################################################
# Fuzzer
################################################################################
USER root:root
RUN mkdir -p ${FUZZER} && chown magma:magma ${FUZZER}
COPY --chown=magma:magma ${HOST_CONTEXT_ROOT}/fuzzers/${FUZZER_NAME} ${FUZZER}
RUN ${FUZZER}/preinstall.sh

USER magma:magma
RUN ${FUZZER}/fetch.sh
RUN ${FUZZER}/build.sh

USER root:root
# Build AFL++ QEMU mode
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y \
	ninja-build pkg-config libglib2.0-dev

USER magma:magma
RUN cd ${FUZZER}/repo/qemu_mode && \
    CPU_TARGET=${TARGET_ARCH%%-*} ./build_qemu_support.sh
# CAUTION: Shell parameter expansion works for most architectures, but not all!
#          (As this is primarly for arm, I don't want to bloat the Dockerfile.)



################################################################################
# [INFO]: From now on everything is cross compiled, so we can set CC, CXX, etc.
#         to the target architecture
################################################################################
ENV CC=${TARGET_CC}
ENV CXX=${TARGET_CXX}
ENV AR=${TARGET_AR}
ENV LD=${TARGET_LD}
ENV NM=${TARGET_NM}
ENV RANLIB=${TARGET_RANLIB}

ENV MAGMA_BUILD_FLAGS="-include ${MAGMA}/src/canary.h \
    ${canaries:+-DMAGMA_ENABLE_CANARIES} \
    ${fixes:+-DMAGMA_ENABLE_FIXES} \
    ${isan:+-DMAGMA_FATAL_CANARIES} \
    ${harden:+-DMAGMA_HARDEN_CANARIES}"
ENV BUILD_FLAGS="-g -O0 -fPIC"

ENV CFLAGS="${MAGMA_BUILD_FLAGS} ${BUILD_FLAGS}"
ENV CXXFLAGS="${MAGMA_BUILD_FLAGS} ${BUILD_FLAGS}"
ENV LDFLAGS="-L${OUT} -g"
ENV LIBS="-l:magma.o -lrt"

################################################################################
# Build AFL++ QEMU Driver - cross-compilation
################################################################################
USER magma:magma
COPY --chown=magma:magma \
    ${HOST_CONTEXT_ROOT}/tools/pirate/scripts/aflpp_driver_cross.sh \
    ${FUZZER}
RUN ${FUZZER}/aflpp_driver_cross.sh
ENV LIBS="${LIBS} ${OUT}/driver/libAFLQemuDriver.a"

################################################################################
# Magma instrumentation - cross-compilation
################################################################################
USER magma:magma
COPY --chown=magma:magma \
    ${HOST_CONTEXT_ROOT}/tools/pirate/scripts/magma_build_cross.sh \
    ${MAGMA}
RUN ${MAGMA}/magma_build_cross.sh

################################################################################
# Target - cross-compilation
# -> replaces ${FUZZER}/instrument.sh, as we don't have source code instrument.
#
# I.e. Targets are not built with the afl compiler (afl-clang-fast++) but with
# a "normal" cross-compiler
################################################################################
USER root:root
RUN mkdir -p ${FUZZER} && chown magma:magma ${FUZZER}
COPY --chown=magma:magma ${HOST_CONTEXT_ROOT}/targets/${TARGET_NAME} ${TARGET}
COPY --chown=magma:magma \
    ${HOST_CONTEXT_ROOT}/tools/pirate/scripts/${TARGET_NAME}_build_cross.sh \
    ${TARGET}
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y zlib1g-dev:armhf

RUN ${TARGET}/preinstall.sh

USER magma:magma
RUN ${TARGET}/fetch.sh && \
    ${MAGMA}/apply_patches.sh
RUN ${TARGET}/${TARGET_NAME}_build_cross.sh


ENTRYPOINT "/bin/bash"


