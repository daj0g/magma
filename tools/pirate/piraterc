# (default: ./workdir)
ORKDIR=./workdir

# [TARGET_NAME]: name of the target library to fuzz
# needs to match a directory name if magma/targets
# (default: libpng)
TARGET_NAME=libpng

# [CANARY_MODE]: defines the mode of canaries at compile time (default: 1)
# - 1: without fixes, with canaries
# - 2: without fixes, without canaries
# - 3: with fixes, without canaries
# - 4: library provided -> (this is a slight abuse of the feature)
CANARY_MODE=1

# [BUG}: Specify bug that should be enabled.
# If empty/unset:
#   - CANARY_MODE 1-3: all bugs are enabled
#   - CANARY_MODE 4:   Error, BUG has to be specified
# BUG=PNG005

# [PRECOMPILED_LIB_NAME]: Name of precompiled library.
# Needs to be stored in precompiled/$TARGET_NAME/$BUG
# PRECOMPILED_LIB_NAME=

# [OPTIMIZATION]: gcc compile optimization level
OPTIMIZATION=3

# [ISAN]: if set, build the benchmark with ISAN/fatal canaries (default: unset)
# ISAN=1

# [HARDEN]: if set, build the benchmark with hardened canaries (default: unset)
# HARDEN=1


####################
# Runtime variables
####################
# [PROGRAM_NAME]: name of harness
# (default: first directory found in target/corpus/ directory)
PROGRAM_NAME=libpng_read_fuzzer_pirate

# [PROGRAM_ARGS]: additional arguments for the hanress
# (default: unset)
# PROGRAM_ARGS=

# [CORPUS_NAME]: name of harnes of which the corpus directory is used.
# This is useful, if the harness is not included in the original magma fiels.
# (default: PROGRAM_NAME)
CORPUS_NAME=libpng_read_fuzzer

# [INCLUDE_POV]: if set, include previously extracted PoVs in fuzzer input dir
# (default: unset)
# INCLUDE_POV=1


# [TIMEOUT]: time to run each campaign. This variable supports one-letter
# suffixes to indicate duration (s: seconds, m: minutes, h: hours, d: days)
# (default: 5m)
TIMEOUT=15m

# [POLL]: time (in seconds) between polls (default: 5)
POLL=5

# [WORKERS]: number of "dumb" fuzzing slave instanced (default: 2)
WORKERS=2